#!/usr/bin/env bash
# Task A is deliberately pinned to the legacy visual-recognition program.
# It must never start the Track 1 search/approach/grasp vision runtime.

set -o pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LEGACY_LAUNCHER="${TRACK1_VISUAL_LAUNCHER:-/home/sunshine/codex/easton/taskA/camera_recognition.py}"
GRAB_LAUNCHER="${TRACK1_GRAB_LAUNCHER:-/home/sunshine/.local/bin/track1_camera_recognition}"
GRAB_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/track1-camera-recognition/recognition.pid"
TASK_PID_FILE="$ROOT/state/task.pid"

show_error() {
    local message="$1"
    printf '错误：%s\n' "$message" >&2
    if command -v notify-send >/dev/null 2>&1; then
        notify-send --app-name="任务A 视觉识别" "任务A 视觉识别" "$message" \
            >/dev/null 2>&1 || true
    fi
    if command -v zenity >/dev/null 2>&1; then
        zenity --error --title="任务A 视觉识别" --text="$message" \
            --width=620 >/dev/null 2>&1 || true
    fi
}

# Status and stop commands must not alter any other running recognizer.
case "${1:-}" in
    --stop|--status|--help|-h)
        [ -r "$LEGACY_LAUNCHER" ] || {
            show_error "找不到旧版视觉识别程序：$LEGACY_LAUNCHER"
            exit 1
        }
        exec /usr/bin/python3 "$LEGACY_LAUNCHER" "$@"
        ;;
esac

[ -r "$LEGACY_LAUNCHER" ] || {
    show_error "找不到旧版视觉识别程序：$LEGACY_LAUNCHER"
    exit 1
}

# Never take the D405 away from a running B/C/D/E task.
if [ -r "$TASK_PID_FILE" ]; then
    task_pid="$(tr -d '[:space:]' < "$TASK_PID_FILE" 2>/dev/null || true)"
    if [[ "$task_pid" =~ ^[0-9]+$ ]] && kill -0 "$task_pid" 2>/dev/null; then
        task_cmd="$(tr '\0' ' ' < "/proc/$task_pid/cmdline" 2>/dev/null || true)"
        if [[ "$task_cmd" == *track1_grasp.nodes.track1_node* ]]; then
            show_error "任务B/C/D/E 正在运行并占用相机。请先双击“停止当前任务”。"
            exit 1
        fi
    fi
fi

# The D405 can only have one owner. Starting Task A releases the standalone
# grab-recognition viewer first; the reverse transition is handled by its launcher.
if [ -s "$GRAB_STATE" ] && [ -x "$GRAB_LAUNCHER" ]; then
    if ! "$GRAB_LAUNCHER" stop >/dev/null 2>&1; then
        show_error "“抓取识别”仍在运行，无法释放相机。请先停止它再打开任务A。"
        exit 1
    fi
fi

exec /usr/bin/python3 "$LEGACY_LAUNCHER" "$@"
