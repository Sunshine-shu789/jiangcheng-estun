import math
import threading
import time

import numpy as np
import rclpy
from rclpy.executors import SingleThreadedExecutor
from rclpy.node import Node

from track1_grasp.config import load_config, load_joint_pose_file
from track1_grasp.motion import build_motion, joints_within_limits

ROOT = '/media/sunshine/新加卷1/埃斯顿比赛_2026/赛道一比赛程序'
CONFIG_PATH = ROOT + '/config/track1_task_cd_40class_v11_official.yaml'
POSE_PATH = ROOT + '/config/task_cd_observation_pose_20261101_194651.yaml'

config = load_config(CONFIG_PATH)
if config.motion.backend != 'robotmove' or config.motion.dry_run:
    raise RuntimeError('refusing move: formal live robotmove configuration is required')
target_q = np.asarray(
    load_joint_pose_file(POSE_PATH, expected_role='task_cd_observation'),
    dtype=float,
)
if target_q.shape != (6,) or not np.all(np.isfinite(target_q)):
    raise RuntimeError('refusing move: observation pose is invalid')
if not joints_within_limits(
    target_q,
    math.radians(float(config.motion.joint_limit_margin_deg)),
):
    raise RuntimeError('refusing move: observation pose violates joint limits')

rclpy.init(args=[])
node = Node('track1_observation_move_only')
executor = SingleThreadedExecutor()
executor.add_node(node)
spin_thread = threading.Thread(target=executor.spin, daemon=True)
spin_thread.start()
motion = build_motion(
    config.motion,
    node=node,
    log=lambda message: print(message, flush=True),
)

def describe(label, state):
    print(
        f'{label}: state={state.controller_state!r} ready={state.ready} '
        f'fault_flag={state.fault_flag} joints_deg='
        f'{np.round(np.degrees(state.joints), 3).tolist() if state.joints else None}',
        flush=True,
    )

try:
    time.sleep(1.0)
    before = motion.wait_for_state(8.0)
    describe('BEFORE', before)
    if (
        not before.ready
        or before.fault
        or before.fault_flag != 0
        or before.joints is None
        or len(before.joints) != 6
        or not np.all(np.isfinite(np.asarray(before.joints, dtype=float)))
    ):
        raise RuntimeError(f'pre-move safety check failed: {before.message}')

    print(
        'TARGET_DEG=' + str(np.round(np.degrees(target_q), 6).tolist()),
        flush=True,
    )
    print(
        'MAX_DELTA_DEG=' + str(round(float(np.degrees(np.max(np.abs(target_q - np.asarray(before.joints))))), 3)),
        flush=True,
    )
    print('SENDING task_cd_observation_entry', flush=True)
    actual = np.asarray(
        motion.move_joints(target_q, name='task_cd_observation_entry'),
        dtype=float,
    )
    feedback = motion.get_state()
    describe('AFTER', feedback)
    if (
        not feedback.ready
        or feedback.fault
        or feedback.fault_flag != 0
        or feedback.joints is None
        or len(feedback.joints) != 6
        or not np.all(np.isfinite(np.asarray(feedback.joints, dtype=float)))
    ):
        raise RuntimeError(f'post-move feedback is unsafe: {feedback.message}')
    residual_deg = float(
        np.max(np.degrees(np.abs(np.asarray(feedback.joints, dtype=float) - target_q)))
    )
    tolerance_deg = float(config.task_cd.observation_pose_tolerance_deg)
    print(f'RESIDUAL_DEG={residual_deg:.6f}', flush=True)
    print(f'TOLERANCE_DEG={tolerance_deg:.6f}', flush=True)
    if residual_deg > tolerance_deg:
        raise RuntimeError(
            f'observation pose verification failed: residual={residual_deg:.3f} deg '
            f'> {tolerance_deg:.3f} deg'
        )
    print('RESULT=PASS: fixed observation pose reached and verified', flush=True)
finally:
    executor.shutdown(timeout_sec=2.0)
    node.destroy_node()
    if rclpy.ok():
        rclpy.shutdown()
