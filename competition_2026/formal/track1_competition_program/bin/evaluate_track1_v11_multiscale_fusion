#!/usr/bin/env bash
set -euo pipefail
ROOT="/media/sunshine/新加卷/埃斯顿比赛_2026/赛道一比赛程序"
PYTHON="${TRACK1_PREP_PYTHON:-/usr/bin/python3}"
SITE_PACKAGES="${TRACK1_PREP_SITE_PACKAGES:-/media/sunshine/新加卷/taskA/venv/lib/python3.10/site-packages}"
CACHE_ROOT="$ROOT/cache/track1_training"
"$ROOT/bin/ensure_runtime"
mkdir -p "$CACHE_ROOT/tmp" "$CACHE_ROOT/matplotlib" "$CACHE_ROOT/numba" "$CACHE_ROOT/cuda" "$CACHE_ROOT/torch" "$CACHE_ROOT/xdg"
exec env \
  PYTHONNOUSERSITE=1 \
  PYTHONDONTWRITEBYTECODE=1 \
  PYTHONPATH="$SITE_PACKAGES:$ROOT/app/track1_training_prep:$ROOT/app/track1_capture_web" \
  TMPDIR="$CACHE_ROOT/tmp" TEMP="$CACHE_ROOT/tmp" TMP="$CACHE_ROOT/tmp" \
  MPLCONFIGDIR="$CACHE_ROOT/matplotlib" NUMBA_CACHE_DIR="$CACHE_ROOT/numba" \
  CUDA_CACHE_PATH="$CACHE_ROOT/cuda" TORCH_HOME="$CACHE_ROOT/torch" \
  XDG_CACHE_HOME="$CACHE_ROOT/xdg" YOLO_CONFIG_DIR="$ROOT/config/ultralytics" \
  PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
  "$PYTHON" "$ROOT/app/track1_training_prep/evaluate_v11_multiscale_fusion.py" "$@"
