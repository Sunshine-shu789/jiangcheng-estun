#!/usr/bin/env bash
# Build a new derived Track-1 dataset; never modifies the raw capture session.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="${TRACK1_CURATION_PYTHON:-/usr/bin/python3}"
SITE_PACKAGES="${TRACK1_CURATION_SITE_PACKAGES:-/media/sunshine/新加卷/taskA/venv/lib/python3.10/site-packages}"
exec env PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$SITE_PACKAGES" \
    "$PYTHON" "$ROOT/bin/track1_selfcollected_curation_v3.py" build "$@"
