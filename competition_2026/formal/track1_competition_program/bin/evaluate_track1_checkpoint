#!/usr/bin/env bash
# Evaluate a Track-1 checkpoint on the full v12 val, isolated multi-object val,
# and optionally the reviewed train-overlap diagnostic set.
set -euo pipefail
ROOT="/media/sunshine/新加卷/埃斯顿比赛_2026/赛道一比赛程序"
PYTHON="${TRACK1_PREP_PYTHON:-/usr/bin/python3}"
SITE_PACKAGES="${TRACK1_PREP_SITE_PACKAGES:-/media/sunshine/新加卷/taskA/venv/lib/python3.10/site-packages}"
APP_DIR="$ROOT/app/track1_training_prep"
CACHE_ROOT="$ROOT/cache/track1_eval"
mkdir -p "$CACHE_ROOT/tmp" "$CACHE_ROOT/matplotlib" "$CACHE_ROOT/numba" \
  "$CACHE_ROOT/cuda" "$CACHE_ROOT/torch" "$CACHE_ROOT/xdg/torch/kernels" \
  "$ROOT/config/ultralytics" "$ROOT/reports"
"$ROOT/bin/ensure_runtime"

TMP_ALIAS="/tmp/track1_eval_tmp_$(id -u)"
if [ -L "$TMP_ALIAS" ]; then
  [ "$(readlink -f "$TMP_ALIAS")" = "$(readlink -f "$CACHE_ROOT/tmp")" ] || {
    echo "评估临时目录别名指向错误：$TMP_ALIAS" >&2
    exit 1
  }
elif [ -e "$TMP_ALIAS" ]; then
  echo "评估临时目录别名被普通文件占用：$TMP_ALIAS" >&2
  exit 1
else
  ln -s "$CACHE_ROOT/tmp" "$TMP_ALIAS"
fi

exec env \
  TRACK1_PROJECT_ROOT="$ROOT" \
  PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 \
  PYTHONPATH="$SITE_PACKAGES:$APP_DIR:$ROOT/app" \
  TMPDIR="$TMP_ALIAS" TEMP="$TMP_ALIAS" TMP="$TMP_ALIAS" \
  MPLCONFIGDIR="$CACHE_ROOT/matplotlib" NUMBA_CACHE_DIR="$CACHE_ROOT/numba" \
  CUDA_CACHE_PATH="$CACHE_ROOT/cuda" TORCH_HOME="$CACHE_ROOT/torch" \
  XDG_CACHE_HOME="$CACHE_ROOT/xdg" YOLO_CONFIG_DIR="$ROOT/config/ultralytics" \
  WANDB_MODE=disabled PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
  "$PYTHON" "$APP_DIR/evaluate_track1_checkpoint.py" "$@"
