#!/usr/bin/env bash
# Strictly read-only ESTUN SGS Modbus TCP diagnostic.
set -o pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP_DIR="$ROOT/app/track1_grasp"
PYTHON="${TRACK1_PYTHON:-/usr/bin/python3}"

"$ROOT/bin/ensure_runtime" || exit 1
export PYTHONPATH="$APP_DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON" -m track1_grasp.tools.sgs_modbus_probe "$@"
