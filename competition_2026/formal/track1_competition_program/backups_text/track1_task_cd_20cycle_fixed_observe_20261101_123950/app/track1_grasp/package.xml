<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>track1_grasp</name>
  <version>0.2.0</version>
  <description>Hardware-agnostic Track 1 (A/B/C/D/E) vision-arm-gripper orchestration framework.</description>
  <maintainer email="sunshine@example.com">sunshine</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>trajectory_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>codroid_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>taskA_grasp</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
