<?xml version="1.0"?>
<!--
  Offline planning semantics for the controller-DH-matched S3-60-G2 and the
  provisional FAE2MR86M-D / MS42DC tool assembly.

  `arm` retains the six-axis flange chain used by the controller.  `gripper`
  exposes the two prismatic CAD approximation joints.  `arm_with_tool` ends at
  grasp_tcp and is the preferred group for closed-loop grasp candidate IK.

  The gripper transform and prismatic finger model are provisional offline
  approximations.  Collision matrices below disable only physically adjacent
  links or the zero-mass TCP attachment.  The left/right finger pair is NOT
  disabled: their real geometry and flexible linkage must remain a checked
  collision pair.
-->
<robot name="estun_s3_60_g2">
  <virtual_joint name="world_to_base" type="fixed" parent_frame="world" child_link="base_link"/>

  <group name="arm">
    <chain base_link="base_link" tip_link="flange_link"/>
  </group>

  <group name="gripper">
    <joint name="gripper_left_finger_joint"/>
    <joint name="gripper_right_finger_joint"/>
  </group>

  <group name="arm_with_tool">
    <chain base_link="base_link" tip_link="grasp_tcp"/>
  </group>

  <group_state name="zero" group="arm">
    <joint name="joint1" value="0"/>
    <joint name="joint2" value="0"/>
    <joint name="joint3" value="0"/>
    <joint name="joint4" value="0"/>
    <joint name="joint5" value="0"/>
    <joint name="joint6" value="0"/>
  </group_state>

  <group_state name="offline_demo" group="arm">
    <joint name="joint1" value="0.3"/>
    <joint name="joint2" value="0.6"/>
    <joint name="joint3" value="-0.6"/>
    <joint name="joint4" value="0.3"/>
    <joint name="joint5" value="0.7"/>
    <joint name="joint6" value="0.5"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="gripper_left_finger_joint" value="0"/>
    <joint name="gripper_right_finger_joint" value="0"/>
  </group_state>

  <group_state name="closed" group="gripper">
    <joint name="gripper_left_finger_joint" value="-0.0362745"/>
    <joint name="gripper_right_finger_joint" value="-0.0362745"/>
  </group_state>

  <!-- Arm chain: only physically contiguous parent/child pairs. -->
  <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="flange_link" reason="Adjacent"/>

  <!-- Tool chain: actual adjacent or zero-mass fixed attachments only. -->
  <disable_collisions link1="flange_link" link2="gripper_body_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_body_link" link2="gripper_left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_body_link" link2="gripper_right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_body_link" link2="grasp_tcp" reason="Adjacent"/>

  <!-- The calibrated camera is bolted to the flange.  Keep camera-to-body,
       camera-to-finger and arm-to-gripper checks active. -->
  <disable_collisions link1="flange_link" link2="d405_camera_link" reason="Adjacent"/>
  <disable_collisions link1="link6" link2="d405_camera_link" reason="Always"/>
</robot>
